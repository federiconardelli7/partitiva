{
  "name": "partitiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestione open source e privacy-first della Partita IVA in regime forfettario",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check-privacy": "node scripts/check-privacy.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check-privacy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
